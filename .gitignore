# Upstream repositories we read but do not vendor.
/bootc-jetson/
/particleos/

# Captured serial console output.
/tty_console_output.txt
*.console.log

# Working notes, kept locally but not published. provisioning.md is the
# exception: it ships with the repository.
/design_doc.md
/docs/*
!/docs/provisioning.md

# Everything mkosi writes. The two cache directories are worth keeping between
# builds -- see thor/mkosi.conf -- but they are downloads, not sources.
/thor/mkosi.output/
/thor/mkosi.cache/
/thor/mkosi.pkgcache/
/thor/mkosi.builddir/

# Local overrides. mkosi reads these before anything else, so they are the place
# for settings that belong to one machine rather than to the project.
/thor/mkosi.local.conf
/thor/mkosi.local/

# Disk images, wherever they end up.
*.raw
*.raw.zst
*.raw.zst.sha256
