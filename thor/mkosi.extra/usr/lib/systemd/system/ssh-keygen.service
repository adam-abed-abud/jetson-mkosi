# Ubuntu generates SSH host keys in the package's postinstall script, so a
# system whose /etc is created on the device never gets any and sshd refuses to
# start. Generate them on first boot instead, which is also what keeps every
# device from sharing one identity.

[Unit]
Description=Generate SSH host keys
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.service
DefaultDependencies=no
After=systemd-tmpfiles-setup.service
RequiresMountsFor=/etc/ssh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=multi-user.target
